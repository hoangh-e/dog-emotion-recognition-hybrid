        "        significant = p_value < 0.05\n",
        "\n",
        "        # Mann-Whitney U test (non-parametric)\n",
        "        u_stat, u_p_value = mannwhitneyu(ensemble_scores, base_scores, alternative='two-sided')\n",
        "        u_significant = u_p_value < 0.05\n",
