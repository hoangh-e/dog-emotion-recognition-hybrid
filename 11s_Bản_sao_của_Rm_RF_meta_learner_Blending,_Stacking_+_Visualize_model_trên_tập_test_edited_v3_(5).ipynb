      "source": [
        "# ===== ENSEMBLE WRAPPER CLASS CHO K-FOLD CV =====\n",
        "class EnsembleWrapper(BaseEstimator, ClassifierMixin):\n",
        "    \"\"\"Wrapper class để sử dụng ensemble methods trong K-fold CV\"\"\"\n",
        "    \n",
        "    def __init__(self, ensemble_type='simple_voting', base_predictions=None, base_models=None):\n",
        "        self.ensemble_type = ensemble_type\n",
        "        self.base_predictions = base_predictions\n",
        "        self.base_models = base_models\n",
        "        self.meta_learner = None\n",
        "        self.weights = None\n",
        "        \n",
        "    def fit(self, X, y):\n",
        "        \"\"\"Fit ensemble method\"\"\"\n",
        "        if self.ensemble_type == 'stacking':\n",
        "            # Train meta-learner cho stacking\n",
        "            self.meta_learner = RandomForestClassifier(n_estimators=100, random_state=42, max_depth=5)\n",
        "            self.meta_learner.fit(X, y)\n",
        "        elif self.ensemble_type == 'blending':\n",
        "            # Calculate weights cho blending\n",
        "            self.weights = self._calculate_weights(X, y)\n",
        "        return self\n",
        "        \n",
        "    def predict(self, X):\n",
        "        \"\"\"Predict using ensemble method\"\"\"\n",
        "        if self.ensemble_type == 'simple_voting':\n",
        "            return self._simple_voting_predict(X)\n",
        "        elif self.ensemble_type == 'weighted_voting':\n",
        "            return self._weighted_voting_predict(X)\n",
        "        elif self.ensemble_type == 'stacking':\n",
        "            return self.meta_learner.predict(X)\n",
        "        elif self.ensemble_type == 'blending':\n",
        "            return self._blending_predict(X)\n",
        "        \n",
        "    def _simple_voting_predict(self, X):\n",
        "        # Implement simple voting\n",
        "        predictions = []\n",
        "        for i in range(len(X)):\n",
        "            votes = [int(pred) for pred in X[i]]\n",
        "            prediction = max(set(votes), key=votes.count)\n",
        "            predictions.append(prediction)\n",
        "        return np.array(predictions)\n",
        "    \n",
        "    def _weighted_voting_predict(self, X):\n",
        "        # Implement weighted voting\n",
        "        if self.weights is None:\n",
        "            return self._simple_voting_predict(X)\n",
        "        \n",
        "        predictions = []\n",
        "        for i in range(len(X)):\n",
        "            weighted_sum = np.zeros(3)  # 3 classes\n",
        "            for j, weight in enumerate(self.weights):\n",
        "                pred_class = int(X[i][j])\n",
        "                weighted_sum[pred_class] += weight\n",
        "            predictions.append(np.argmax(weighted_sum))\n",
        "        return np.array(predictions)\n",
        "    \n",
        "    def _blending_predict(self, X):\n",
        "        # Implement blending prediction\n",
        "        return self._weighted_voting_predict(X)\n",
        "    \n",
        "    def _calculate_weights(self, X, y):\n",
        "        # Calculate weights based on individual model accuracy\n",
        "        weights = []\n",
        "        n_models = X.shape[1]\n",
        "        \n",
        "        for i in range(n_models):\n",
        "            model_preds = X[:, i]\n",
        "            acc = accuracy_score(y, model_preds)\n",
        "            weights.append(acc)\n",
        "        \n",
        "        # Normalize weights\n",
        "        weights = np.array(weights)\n",
        "        weights = weights / np.sum(weights)\n",
        "        return weights\n",
        "\n",
        "print(\"✅ EnsembleWrapper class defined successfully\")"
      ]
    },
