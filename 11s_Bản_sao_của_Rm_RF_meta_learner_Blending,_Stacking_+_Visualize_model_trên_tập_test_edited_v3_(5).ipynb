        "            'accuracies': base_model_accuracies,\n",
        "            'best_single': max(base_model_accuracies.items(), key=lambda x: x[1])\n",
        "        },\n",
        "        'ensemble_methods': {}\n",
        "    }\n",
        "    \n",
        "    # Process ensemble results\n",
        "    for method, results in ensemble_results.items():\n",
        "        try:\n",
        "            if isinstance(results, dict) and 'accuracy' in results:\n",
        "                accuracy = results['accuracy']\n",
        "                summary['ensemble_methods'][method] = {\n",
        "                    'accuracy': accuracy,\n",
        "                    'improvement_over_best_single': accuracy - summary['base_models']['best_single'][1],\n",
        "                    'rank': 0  # Will be set later\n",
        "                }\n",
        "            print(f\"  ✅ {method}: {accuracy:.3f}\")\n",
        "        except Exception as e:\n",
        "            print(f\"  ❌ {method}: Error - {str(e)[:30]}...\")\n",
        "    \n",
        "    # Rank ensemble methods\n",
        "    sorted_methods = sorted(\n",
        "        summary['ensemble_methods'].items(),\n",
        "        key=lambda x: x[1]['accuracy'],\n",
        "        reverse=True\n",
        "    )\n",
        "    \n",
        "    for rank, (method, data) in enumerate(sorted_methods, 1):\n",
        "        summary['ensemble_methods'][method]['rank'] = rank\n",
        "    \n",
        "    return summary\n",
        "\n",
        "print(\"✅ Performance summary function ready\")"
