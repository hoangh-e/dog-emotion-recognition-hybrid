        "# ===== K-FOLD CROSS-VALIDATION CHO ENSEMBLE METHODS =====\n",
        "def perform_ensemble_kfold_cv(train_results, test_results, k=5):\n",
        "    \"\"\"\n",
        "    Thực hiện K-fold cross-validation cho các ensemble methods\n",
        "    \"\"\"\n",
        "    print(f\"\\n🔄 Starting {k}-Fold Cross-Validation for Ensemble Methods...\")\n",
        "    print(\"=\"*70)\n",
        "    \n",
        "    # Chuẩn bị dữ liệu từ kết quả hiện có\n",
        "    train_models = {r['algorithm']: r for r in train_results}\n",
        "    test_models = {r['algorithm']: r for r in test_results}\n",
        "    common_models = list(set(train_models.keys()) & set(test_models.keys()))\n",
        "    \n",
        "    if len(common_models) < 2:\n",
        "        print(f\"❌ Insufficient models for ensemble CV: {len(common_models)}\")\n",
        "        return None\n",
        "    \n",
        "    print(f\"📊 Using {len(common_models)} base models: {common_models}\")\n",
        "    \n",
        "    # Tạo feature matrix từ predictions\n",
        "    n_train_samples = len(train_results[0]['ground_truths'])\n",
        "    n_test_samples = len(test_results[0]['ground_truths'])\n",
        "    \n",
        "    X_train = np.zeros((n_train_samples, len(common_models)))\n",
        "    y_train = np.array(train_results[0]['ground_truths'])\n",
        "    \n",
        "    X_test = np.zeros((n_test_samples, len(common_models)))\n",
        "    y_test = np.array(test_results[0]['ground_truths'])\n",
        "    \n",
        "    # Fill feature matrices\n",
        "    for i, model_name in enumerate(common_models):\n",
        "        X_train[:, i] = train_models[model_name]['predictions']\n",
        "        X_test[:, i] = test_models[model_name]['predictions']\n",
        "    \n",
        "    # Các ensemble methods để test\n",
        "    ensemble_methods = {\n",
        "        'Simple_Voting': EnsembleWrapper('simple_voting'),\n",
        "        'Weighted_Voting': EnsembleWrapper('weighted_voting'),\n",
        "        'Stacking_RF': EnsembleWrapper('stacking'),\n",
        "        'Blending': EnsembleWrapper('blending')\n",
        "    }\n",
        "    \n",
        "    # Storage cho kết quả\n",
        "    cv_results = {}\n",
        "    fold_details = {}\n",
        "    \n",
        "    # Stratified K-Fold\n",
        "    skf = StratifiedKFold(n_splits=k, shuffle=True, random_state=42)\n",
        "    \n",
        "    # Thực hiện CV cho từng ensemble method\n",
        "    for method_name, ensemble in ensemble_methods.items():\n",
        "        print(f\"\\n🎯 Testing {method_name}...\")\n",
        "        \n",
        "        fold_scores = []\n",
        "        fold_predictions = []\n",
        "        fold_ground_truths = []\n",
        "        \n",
        "        start_time = time.time()\n",
        "        \n",
        "        for fold, (train_idx, val_idx) in enumerate(skf.split(X_train, y_train)):\n",
        "            print(f\"   Fold {fold+1}/{k}...\", end=\" \")\n",
        "            \n",
        "            # Split data for this fold\n",
        "            X_fold_train, X_fold_val = X_train[train_idx], X_train[val_idx]\n",
        "            y_fold_train, y_fold_val = y_train[train_idx], y_train[val_idx]\n",
        "            \n",
        "            # Train ensemble on fold\n",
        "            try:\n",
        "                ensemble_copy = EnsembleWrapper(ensemble.ensemble_type)\n",
        "                ensemble_copy.fit(X_fold_train, y_fold_train)\n",
        "                \n",
        "                # Predict on validation set\n",
        "                fold_preds = ensemble_copy.predict(X_fold_val)\n",
        "                fold_score = accuracy_score(y_fold_val, fold_preds)\n",
        "                \n",
        "                fold_scores.append(fold_score)\n",
        "                fold_predictions.extend(fold_preds)\n",
        "                fold_ground_truths.extend(y_fold_val)\n",
        "                \n",
        "                print(f\"Acc: {fold_score:.4f}\")\n",
        "                \n",
        "            except Exception as e:\n",
        "                print(f\"❌ Error: {e}\")\n",
        "                fold_scores.append(0.0)\n",
        "        \n",
        "        elapsed_time = time.time() - start_time\n",
        "        \n",
        "        # Calculate mean and std across folds\n",
        "        mean_score = np.mean(fold_scores)\n",
        "        std_score = np.std(fold_scores)\n",
        "        \n",
        "        cv_results[method_name] = {\n",
        "            'mean_accuracy': mean_score,\n",
        "            'std_accuracy': std_score,\n",
        "            'fold_scores': fold_scores,\n",
        "            'all_predictions': fold_predictions,\n",
        "            'all_ground_truths': fold_ground_truths,\n",
        "            'training_time': elapsed_time\n",
        "        }\n",
        "        \n",
        "        print(f\"   ✅ Mean CV Accuracy: {mean_score:.4f} ± {std_score:.4f}\")\n",
        "        print(f\"   ⏱️  Training Time: {elapsed_time:.2f}s\")\n",
        "    \n",
        "    # Tìm best fold cho mỗi method\n",
        "    best_folds = {}\n",
        "    for method_name, results in cv_results.items():\n",
        "        best_fold_idx = np.argmax(results['fold_scores'])\n",
        "        best_folds[method_name] = {\n",
        "            'fold_index': best_fold_idx,\n",
        "            'best_score': results['fold_scores'][best_fold_idx],\n",
        "            'method_name': method_name\n",
        "        }\n",
        "    \n",
        "    # Test best ensemble trên test set\n",
        "    print(f\"\\n🏆 Testing Best Ensembles on Test Set...\")\n",
        "    test_results_ensemble = {}\n",
        "    \n",
        "    for method_name in cv_results.keys():\n",
        "        print(f\"   Testing {method_name}...\", end=\" \")\n",
        "        try:\n",
        "            ensemble_final = EnsembleWrapper(ensemble_methods[method_name].ensemble_type)\n",
        "            ensemble_final.fit(X_train, y_train)\n",
        "            \n",
        "            test_preds = ensemble_final.predict(X_test)\n",
        "            test_acc = accuracy_score(y_test, test_preds)\n",
        "            \n",
        "            test_results_ensemble[method_name] = {\n",
        "                'algorithm': f'{method_name}_KFold',\n",
        "                'predictions': test_preds.tolist(),\n",
        "                'ground_truths': y_test.tolist(),\n",
        "                'success_count': len(test_preds),\n",
        "                'error_count': 0,\n",
        "                'test_accuracy': test_acc,\n",
        "                'cv_results': cv_results[method_name]\n",
        "            }\n",
        "            \n",
        "            print(f\"Test Acc: {test_acc:.4f}\")\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"❌ Error: {e}\")\n",
        "    \n",
        "    return {\n",
        "        'cv_results': cv_results,\n",
        "        'best_folds': best_folds,\n",
        "        'test_results': test_results_ensemble,\n",
        "        'base_models': common_models\n",
        "    }\n",
        "\n",
        "print(\"✅ K-fold CV ensemble function defined successfully\")"
      ]
    },
