        "def predict_emotion_yolo(image_path, model, device='cuda'):\n",
        "    \"\"\"\n",
        "    Predict emotion using YOLO model for 3-class emotion recognition.\n",
        "    \n",
        "    Parameters:\n",
        "    -----------\n",
        "    image_path : str\n",
        "        Path to the input image\n",
        "    model : YOLO\n",
        "        Trained YOLO model for emotion detection\n",
        "    device : str, default='cuda'\n",
        "        Device to run inference on\n",
        "    \n",
        "    Returns:\n",
        "    --------\n",
        "    dict\n",
        "        Dictionary containing prediction results with format:\n",
        "        {\n",
        "            'predicted': bool,\n",
        "            'angry': float,\n",
        "            'happy': float, \n",
        "            'relaxed': float\n",
        "        }\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # Define emotion classes for 3-class system\n",
        "        emotion_classes = ['angry', 'happy', 'relaxed']\n",
        "        \n",
        "        # Run inference\n",
        "        results = model.predict(image_path, device=device, verbose=False)\n",
        "        \n",
        "        if not results or len(results) == 0:\n",
        "            return {\n",
        "                'predicted': False,\n",
        "                'angry': 0.0,\n",
        "                'happy': 0.0,\n",
        "                'relaxed': 0.0\n",
        "            }\n",
        "        \n",
        "        # Get the first result\n",
        "        result = results[0]\n",
        "        \n",
        "        # Check if any detections were made\n",
        "        if result.boxes is None or len(result.boxes) == 0:\n",
        "            return {\n",
        "                'predicted': False,\n",
        "                'angry': 0.0,\n",
        "                'happy': 0.0,\n",
        "                'relaxed': 0.0\n",
        "            }\n",
        "        \n",
        "        # Get the highest confidence detection\n",
        "        confidences = result.boxes.conf.cpu().numpy()\n",
        "        classes = result.boxes.cls.cpu().numpy()\n",
        "        \n",
        "        # Find the detection with highest confidence\n",
        "        max_conf_idx = confidences.argmax()\n",
        "        predicted_class = int(classes[max_conf_idx])\n",
        "        confidence = float(confidences[max_conf_idx])\n",
        "        \n",
        "        # Convert class index to emotion scores\n",
        "        # Initialize all emotions with low confidence\n",
        "        prediction_scores = {\n",
        "            'angry': 0.1,\n",
        "            'happy': 0.1,\n",
